<?xml version="1.0" encoding="utf-8"?>
<Keyboard xmlns:latin="http://android.com">

    <!-- 1. ഒന്നാം വരി: സ്വരചിഹ്നങ്ങൾ (Vowel Signs) -->
    <Row latin:keyWidth="11.11%p">
        <Key latin:keySpec="&#x0D3E;" /> <!-- ാ -->
        <Key latin:keySpec="&#x0D3F;" /> <!-- ി -->
        <Key latin:keySpec="&#x0D40;" /> <!-- ീ -->
        <Key latin:keySpec="&#x0D41;" /> <!-- ു -->
        <Key latin:keySpec="&#x0D42;" /> <!-- ൂ -->
        <Key latin:keySpec="&#x0D43;" /> <!-- ൃ -->
        <Key latin:keySpec="&#x0D46;" /> <!-- െ -->
        <Key latin:keySpec="&#x0D47;" /> <!-- േ -->
        <Key latin:keySpec="&#x0D48;" /> <!-- ൈ -->
    </Row>

    <!-- 2. രണ്ടാം വരി: ചിഹ്നങ്ങളും Backspace-ഉം -->
    <Row latin:keyWidth="11.11%p">
        <Key latin:keySpec="&#x0D4A;" /> <!-- ൊ -->
        <Key latin:keySpec="&#x0D4B;" /> <!-- ോ -->
        <Key latin:keySpec="&#x0D57;" /> <!-- ൗ -->
        <Key latin:keySpec="&#x0D02;" /> <!-- ം -->
        <Key latin:keySpec="&#x0D03;" /> <!-- ഃ -->
        <Key latin:keySpec="&#x0D4D;" /> <!-- ് (ചന്ദ്രക്കല) -->
        <Key latin:keySpec="." />
        <Key latin:keyStyle="deleteKeyStyle" latin:keyWidth="22.22%p" />
    </Row>

    <!-- 3. മൂന്നാം വരി: 6 ഗ്രൂപ്പുകൾക്കനുസരിച്ച് മാറിവരുന്ന അക്ഷരങ്ങൾ -->
    <switch>
        <!-- ഗ്രൂപ്പ് 1: 'അ' അമർത്തുമ്പോൾ (അ മുതൽ ഐ വരെ) -->
        <case latin:keyboardLayoutSetElement="alphabetManualShifted">
            <Row latin:keyWidth="10%p">
                <Key latin:keySpec="&#x0D05;" /> <!-- അ -->
                <Key latin:keySpec="&#x0D06;" /> <!-- ആ -->
                <Key latin:keySpec="&#x0D07;" /> <!-- ഇ -->
                <Key latin:keySpec="&#x0D08;" /> <!-- ഈ -->
                <Key latin:keySpec="&#x0D09;" /> <!-- ഉ -->
                <Key latin:keySpec="&#x0D0A;" /> <!-- ഊ -->
                <Key latin:keySpec="&#x0D0B;" /> <!-- ഋ -->
                <Key latin:keySpec="&#x0D0E;" /> <!-- എ -->
                <Key latin:keySpec="&#x0D0F;" /> <!-- ഏ -->
                <Key latin:keySpec="&#x0D10;" /> <!-- ഐ -->
            </Row>
        </case>

        <!-- ഗ്രൂപ്പ് 2: 'ഒ' അമർത്തുമ്പോൾ (ഒ, ഓ, ഔ, അം, അഃ, ഌ) -->
        <case latin:keyboardLayoutSetElement="alphabetShiftLocked">
            <Row latin:keyWidth="16.66%p">
                <Key latin:keySpec="&#x0D12;" /> <!-- ഒ -->
                <Key latin:keySpec="&#x0D13;" /> <!-- ഓ -->
                <Key latin:keySpec="&#x0D14;" /> <!-- ഔ -->
                <Key latin:keySpec="&#x0D05;&#x0D02;" /> <!-- അം -->
                <Key latin:keySpec="&#x0D05;&#x0D03;" /> <!-- അഃ -->
                <Key latin:keySpec="&#x0D0C;" /> <!-- ഌ -->
            </Row>
        </case>

        <!-- ഗ്രൂപ്പ് 4: 'ട' അമർത്തുമ്പോൾ (ട മുതൽ ന വരെ) -->
        <case latin:keyboardLayoutSetElement="symbols">
            <Row latin:keyWidth="10%p">
                <Key latin:keySpec="&#x0D1F;" /> <!-- ട -->
                <Key latin:keySpec="&#x0D20;" /> <!-- ഠ -->
                <Key latin:keySpec="&#x0D21;" /> <!-- ഡ -->
                <Key latin:keySpec="&#x0D22;" /> <!-- ഢ -->
                <Key latin:keySpec="&#x0D23;" /> <!-- ണ -->
                <Key latin:keySpec="&#x0D24;" /> <!-- ത -->
                <Key latin:keySpec="&#x0D25;" /> <!-- ഥ -->
                <Key latin:keySpec="&#x0D26;" /> <!-- ദ -->
                <Key latin:keySpec="&#x0D27;" /> <!-- ധ -->
                <Key latin:keySpec="&#x0D28;" /> <!-- ന -->
            </Row>
        </case>

        <!-- ഗ്രൂപ്പ് 5: 'പ' അമർത്തുമ്പോൾ (പ മുതൽ ശ വരെ) -->
        <case latin:keyboardLayoutSetElement="symbolsShifted">
            <Row latin:keyWidth="10%p">
                <Key latin:keySpec="&#x0D2A;" /> <!-- പ -->
                <Key latin:keySpec="&#x0D2B;" /> <!-- ഫ -->
                <Key latin:keySpec="&#x0D2C;" /> <!-- ബ -->
                <Key latin:keySpec="&#x0D2D;" /> <!-- ഭ -->
                <Key latin:keySpec="&#x0D2E;" /> <!-- മ -->
                <Key latin:keySpec="&#x0D2F;" /> <!-- യ -->
                <Key latin:keySpec="&#x0D30;" /> <!-- ര -->
                <Key latin:keySpec="&#x0D32;" /> <!-- ല -->
                <Key latin:keySpec="&#x0D35;" /> <!-- വ -->
                <Key latin:keySpec="&#x0D36;" /> <!-- ശ -->
            </Row>
        </case>

        <!-- ഗ്രൂപ്പ് 6: 'ഷ' അമർത്തുമ്പോൾ (ഷ മുതൽ റ, ചില്ലക്ഷരങ്ങൾ) -->
        <case latin:keyboardLayoutSetElement="phone">
            <Row latin:keyWidth="9.09%p">
                <Key latin:keySpec="&#x0D37;" /> <!-- ഷ -->
                <Key latin:keySpec="&#x0D38;" /> <!-- സ -->
                <Key latin:keySpec="&#x0D39;" /> <!-- ഹ -->
                <Key latin:keySpec="&#x0D33;" /> <!-- ള -->
                <Key latin:keySpec="&#x0D34;" /> <!-- ഴ -->
                <Key latin:keySpec="&#x0D31;" /> <!-- റ -->
                <Key latin:keySpec="&#x0D7A;" /> <!-- ൺ -->
                <Key latin:keySpec="&#x0D7B;" /> <!-- ൻ -->
                <Key latin:keySpec="&#x0D7C;" /> <!-- ർ -->
                <Key latin:keySpec="&#x0D7D;" /> <!-- ൽ -->
                <Key latin:keySpec="&#x0D7E;" /> <!-- ൾ -->
            </Row>
        </case>

        <!-- ഗ്രൂപ്പ് 3 (Default): 'ക' വർഗ്ഗം (ക മുതൽ ഞ വരെ) -->
        <default>
            <Row latin:keyWidth="10%p">
                <Key latin:keySpec="&#x0D15;" /> <!-- ക -->
                <Key latin:keySpec="&#x0D16;" /> <!-- ഖ -->
                <Key latin:keySpec="&#x0D17;" /> <!-- ഗ -->
                <Key latin:keySpec="&#x0D18;" /> <!-- ഘ -->
                <Key latin:keySpec="&#x0D19;" /> <!-- ങ -->
                <Key latin:keySpec="&#x0D1A;" /> <!-- ച -->
                <Key latin:keySpec="&#x0D1B;" /> <!-- ഛ -->
                <Key latin:keySpec="&#x0D1C;" /> <!-- ജ -->
                <Key latin:keySpec="&#x0D1D;" /> <!-- ഝ -->
                <Key latin:keySpec="&#x0D1E;" /> <!-- ഞ -->
            </Row>
        </default>
    </switch>

    <!-- 4. നാലാം വരി: ഗ്രൂപ്പ് മാറ്റാനുള്ള 6 പ്രധാന ബട്ടണുകൾ -->
    <Row latin:keyWidth="16.66%p">
        <Key latin:keyLabel="അ" latin:code="-1" />
        <Key latin:keyLabel="ഒ" latin:code="-2" />
        <Key latin:keyLabel="ക" latin:code="-3" />
        <Key latin:keyLabel="ട" latin:code="-4" />
        <Key latin:keyLabel="പ" latin:code="-5" />
        <Key latin:keyLabel="ഷ" latin:code="-6" />
    </Row>

    <!-- 5. അഞ്ചാം വരി: സ്പേസ്, എന്റർ, ABC, 123 -->
    <Row>
        <Key latin:keyStyle="toAlphaKeyStyle" latin:keyLabel="ABC" latin:keyWidth="15%p" />
        <Key latin:keyStyle="toSymbolKeyStyle" latin:keyLabel="123" latin:keyWidth="15%p" />
        <Key latin:keyStyle="spaceKeyStyle" latin:keyWidth="40%p" />
        <Key latin:keySpec="," latin:keyWidth="12%p" />
        <Key latin:keyStyle="enterKeyStyle" latin:keyWidth="18%p" />
    </Row>

</Keyboard>
